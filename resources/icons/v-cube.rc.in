// The .exe's icon and version, configured into the build tree by
// src/app/CMakeLists.txt.
#include <winver.h>

IDI_ICON1 ICON "@VCUBE_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VCUBE_RC_VERSION@
PRODUCTVERSION @VCUBE_RC_VERSION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "@PROJECT_DESCRIPTION@"
      VALUE "FileVersion", "@VCUBE_VERSION_FULL@"
      VALUE "InternalName", "v-cube"
      VALUE "OriginalFilename", "v-cube.exe"
      VALUE "ProductName", "v-cube"
      VALUE "ProductVersion", "@VCUBE_VERSION_FULL@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
